# Multi-stage image for notes-mcp
# Generated by genproj (docker-container capability, language-aware). Adjust
# for your application.
#
# Stage 1 (build): copies the full source tree, installs dependencies and
# builds the application. Stage 2 (runtime): copies only the build output /
# virtualenv and production dependencies, keeping the final image small.


FROM python:3.12-slim AS build
WORKDIR /app
# Install from the REAL source, once, after it is copied. The generator's
# original shape installed a stub package first (it touched an empty
# src/notes_mcp/__init__.py, ran `pip install .`, then `COPY . .` and reinstalled
# with --no-deps). Under BuildKit layer caching that reinstall could be served
# from a stale cache and leave a package whose __init__.py was the empty stub,
# so `python -m notes_mcp` died with "cannot import name '__version__' from
# 'notes_mcp'" and the container never served HTTP (Buildkite smoke). A single
# install from the copied source removes that class of bug.
COPY . .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && if [ -f requirements.txt ]; then \
         grep -vE '^\s*(-e|--editable)\s+\.' requirements.txt > /tmp/reqs.txt || true; \
         [ -s /tmp/reqs.txt ] && /opt/venv/bin/pip install --no-cache-dir -r /tmp/reqs.txt; \
       fi \
    && if [ -f pyproject.toml ]; then \
         /opt/venv/bin/pip install --no-cache-dir .; \
       fi

FROM python:3.12-slim
WORKDIR /app
# Link the GHCR container package to its GitHub repo on push. GHCR auto-links
# the package to nickbrett1/notes-mcp so it inherits the
# repo's access (public repo -> public package; no manual visibility step).
LABEL org.opencontainers.image.source=https://github.com/nickbrett1/notes-mcp
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=build /opt/venv /opt/venv
COPY . .
EXPOSE 8767

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD curl -fsS http://127.0.0.1:8767/healthz || exit 1
# The image is the deployment artifact and declares an HTTP healthcheck, so its
# default must SERVE HTTP - both the Buildkite smoke step (`docker run IMAGE`,
# no command override) and the Watchtower-deployed compose container rely on it.
# Local clients still get stdio: they spawn `python -m notes_mcp` themselves
# (the module default), not this CMD. Keep in sync via genproj's `command`
# config so `overwrite: true` reproduces it.
CMD ["python","-m","notes_mcp","--transport","streamable-http","--host","0.0.0.0","--port","8767"]
